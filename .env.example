# GEMINI_API_KEY: Opcional para el respaldo LLM del planificador ante diálogos imprevistos.
# Configúralo desde el panel Secrets de AI Studio. Si no se configura o no hay conexión,
# el planificador opera 100% local con la base de conocimiento JSON y reglas de seguridad.
GEMINI_API_KEY=MY_GEMINI_API_KEY
